<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:textColor="@color/row_text_dim"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/row_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/channelTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/external_tag"
        android:textColor="@color/row_text_dim"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
